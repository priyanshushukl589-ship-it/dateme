# Copy this file to ".env.local" (only needed if you run the app on your own computer).
# On Vercel you type these two values into the "Environment Variables" screen instead.
#
# Find both in Supabase: Project Settings -> API (or "API Keys").
# Use the "anon" / "public" key (newer projects call it the "publishable" key).
# NEVER use the "service_role" or "secret" key here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
